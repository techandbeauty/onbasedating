            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>OnBase — The Next Love Story Is Yours</title>\n<meta name=\"description\" content=\"OnBase is a voice-first dating app for military, veterans, and DoD personnel. No photos. No swiping. Real connection first.\">\n<meta property=\"og:title\" content=\"OnBase — The Next Love Story Is Yours\">\n<meta property=\"og:description\" content=\"A voice-first dating experience built for those who serve. Fall for someone's soul before you ever see their face.\">\n<meta property=\"og:type\" content=\"website\">\n<meta http-equiv=\"X-Content-Type-Options\" content=\"nosniff\">\n<meta http-equiv=\"X-Frame-Options\" content=\"DENY\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Dancing+Script:wght@500;600&family=Inter:wght@300;400;500;600&display=swap\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n<script src=\"https://www.google.com/recaptcha/api.js\" async defer></script>\n</head>\n<body>\n\n<section class=\"hero\">\n  <!-- ═══ BACKGROUND VIDEO ═══ -->\n  <div class=\"hero-bg\">\n    <video id=\"heroVideo\" autoplay muted loop playsinline preload=\"auto\">\n<source src=\"https://res.cloudinary.com/didqb05ko/video/upload/a_90,c_fill,ar_16:9,g_center/f_auto,q_auto/reel_on_love_bzc9dt\" type=\"video/mp4\">    </video>\n  </div>\n  <div class=\"hero-overlay\"></div>\n\n  <!-- ═══ NAV ═══ -->\n  <nav>\n    <div class=\"logo\">On<em>Base</em></div>\n    <div class=\"nav-center\">\n      <a href=\"#experience\">The Experience</a>\n      <a href=\"#manifesto\">Manifesto</a>\n      <a href=\"#journal\">Journal</a>\n    </div>\n    <a href=\"#waitlist\" class=\"nav-btn\">Join The Waitlist</a>\n  </nav>\n\n  <!-- ═══ HERO CONTENT ═══ -->\n  <div class=\"hero-content\">\n    <div class=\"hero-left\">\n      <h1 class=\"hero-headline\">\n        The next<br>\n        love story<br>\n        <em>is yours.</em>\n      </h1>\n      <p class=\"hero-subtitle\">\n        A new kind of dating.<br>\n        Built for real connection.\n      </p>\n      <p class=\"hero-script\">Coming Soon</p>\n    </div>\n\n    <div class=\"hero-right\">\n      <p>OnBase is more than<br>just an app. It's a full<br>dating experience.</p>\n      <a href=\"#\" class=\"watch-film\" id=\"watchFilmBtn\">\n        <span class=\"play-btn\">\n          <svg viewBox=\"0 0 10 12\"><path d=\"M0 0 L10 6 L0 12 Z\"/></svg>\n        </span>\n        Watch the Film\n      </a>\n    </div>\n  </div>\n\n  <!-- ═══ WAITLIST CARD ═══ -->\n  <div class=\"waitlist-wrap\" id=\"waitlist\">\n    <div class=\"waitlist\">\n      <!-- Default form view -->\n      <div id=\"formView\">\n        <h2>Be the first to know.</h2>\n        <p class=\"waitlist-sub\">Join the waitlist for early access.</p>\n\n        <form id=\"onbaseForm\" novalidate>\n          <div class=\"row\">\n            <input type=\"text\" id=\"fn\" name=\"firstName\" placeholder=\"First Name\" required autocomplete=\"given-name\" maxlength=\"50\">\n            <input type=\"text\" id=\"ln\" name=\"lastName\" placeholder=\"Last Name\" required autocomplete=\"family-name\" maxlength=\"50\">\n          </div>\n          <input type=\"email\" id=\"em\" name=\"email\" placeholder=\"Email Address\" required autocomplete=\"email\" maxlength=\"100\">\n          <div class=\"row\">\n            <select id=\"interest\" name=\"interest\" required>\n              <option value=\"\" disabled selected>I'm interested in</option>\n              <option value=\"women\">Meeting women</option>\n              <option value=\"men\">Meeting men</option>\n              <option value=\"both\">Meeting anyone</option>\n              <option value=\"undecided\">Still figuring it out</option>\n            </select>\n            <select id=\"affiliation\" name=\"affiliation\" required>\n              <option value=\"\" disabled selected>My status</option>\n              <option value=\"active_duty\">Active Duty Military</option>\n              <option value=\"veteran\">Veteran</option>\n              <option value=\"reservist\">Reservist / Guard</option>\n              <option value=\"dod_cleared\">DoD / Cleared Personnel</option>\n              <option value=\"first_responder\">First Responder</option>\n              <option value=\"military_spouse\">Military Spouse</option>\n              <option value=\"civilian\">Civilian</option>\n              <option value=\"other\">Other</option>\n            </select>\n          </div>\n          <!-- reCAPTCHA v2 checkbox -->\n          <div id=\"recaptchaWrap\" style=\"display:flex;justify-content:center;margin:.4rem 0\">\n            <div class=\"g-recaptcha\" data-sitekey=\"6LecBLQsAAAAAK4xX8k4bflfz2od7C8_VFu_ETuT\" data-theme=\"dark\"></div>\n          </div>\n          <div class=\"hp\" aria-hidden=\"true\"><input type=\"text\" id=\"website\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></div>\n          <button type=\"submit\" id=\"subBtn\">Join The Waitlist</button>\n        </form>\n\n        <div class=\"f-err\" id=\"fErr\"></div>\n        <p class=\"f-privacy\">We respect your privacy. No spam, ever.</p>\n      </div>\n\n      <!-- ═══ ELIGIBLE: Welcome confirmation ═══ -->\n      <div class=\"ty-screen\" id=\"tyScreen\">\n        <div class=\"ty-check\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></svg></div>\n        <h2>Welcome in, <span class=\"ty-name\" id=\"tyName\"></span>.</h2>\n        <p class=\"ty-body\">You're officially on the list. We'll reach out to <strong id=\"tyEmail\"></strong> when OnBase goes live.</p>\n        <div class=\"ty-next\">\n          <div class=\"ty-next-title\">What happens next</div>\n          <div class=\"ty-step\"><div class=\"ty-num\">1</div><p>You're locked in — your spot on the waitlist is saved</p></div>\n          <div class=\"ty-step\"><div class=\"ty-num\">2</div><p>This summer, we'll email you the download link the moment we go live</p></div>\n          <div class=\"ty-step\"><div class=\"ty-num\">3</div><p>Create your voice intro and step into your first connection</p></div>\n        </div>\n        <p class=\"ty-script\">See you soon.</p>\n      </div>\n\n      <!-- ═══ INELIGIBLE: Not available yet ═══ -->\n      <div class=\"ty-screen\" id=\"tyIneligible\">\n        <div class=\"ty-check\" style=\"border-color:var(--gold)\"><svg viewBox=\"0 0 24 24\" style=\"stroke:var(--gold)\"><path d=\"M12 9v4m0 4h.01M12 2a10 10 0 100 20 10 10 0 000-20z\" fill=\"none\" stroke-width=\"1.5\"/></svg></div>\n        <h2>We appreciate you, <span class=\"ty-name\" id=\"tyNameIneligible\"></span>.</h2>\n        <p class=\"ty-body\">OnBase is currently built exclusively for military, veterans, and DoD personnel. This version of the app isn't available to the general public yet — but we're working on expanding.</p>\n        <div class=\"ty-next\">\n          <div class=\"ty-next-title\">You're not forgotten</div>\n          <div class=\"ty-step\"><div class=\"ty-num\">1</div><p>We saved your info so you won't have to sign up again</p></div>\n          <div class=\"ty-step\"><div class=\"ty-num\">2</div><p>When we open OnBase to everyone, you'll be first to know</p></div>\n          <div class=\"ty-step\"><div class=\"ty-num\">3</div><p>In the meantime, share this page with anyone who serves</p></div>\n        </div>\n        <p class=\"ty-script\">We'll be in touch.</p>\n      </div>\n\n      <!-- ═══ DUPLICATE ═══ -->\n      <div class=\"ty-screen\" id=\"tyDuplicate\">\n        <div class=\"ty-check\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></svg></div>\n        <h2>Already here, <span class=\"ty-name\" id=\"tyNameDup\"></span>.</h2>\n        <p class=\"ty-body\">We already have your info. Sit tight — we'll reach out this summer when OnBase goes live.</p>\n        <p class=\"ty-script\">See you soon.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ═══ FOOTER ═══ -->\n<footer>\n  <div class=\"footer-logo\">On<em>Base</em></div>\n  <div class=\"footer-tagline\">Built on intention. Rooted in reality. Made for you.</div>\n  <div class=\"footer-social\">\n    <a href=\"#\" aria-label=\"Instagram\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2M12 0C8.7 0 8.3 0 7.1.1c-1.3.1-2.1.3-2.9.6-.8.3-1.5.7-2.1 1.4C1.4 2.7 1 3.4.7 4.2.4 5 .2 5.8.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.1 1.3.3 2.1.6 2.9.3.8.7 1.5 1.4 2.1.6.6 1.3 1.1 2.1 1.4.8.3 1.6.5 2.9.6 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c1.3-.1 2.1-.3 2.9-.6.8-.3 1.5-.7 2.1-1.4.6-.6 1.1-1.3 1.4-2.1.3-.8.5-1.6.6-2.9.1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.1-1.3-.3-2.1-.6-2.9-.3-.8-.7-1.5-1.4-2.1C21.3 1.4 20.6 1 19.8.7 19 .4 18.2.2 16.9.1 15.7 0 15.3 0 12 0zm0 5.8c-3.4 0-6.2 2.8-6.2 6.2s2.8 6.2 6.2 6.2 6.2-2.8 6.2-6.2S15.4 5.8 12 5.8zm0 10.2c-2.2 0-4-1.8-4-4s1.8-4 4-4 4 1.8 4 4-1.8 4-4 4zm7.8-10.4c0 .8-.6 1.4-1.4 1.4s-1.4-.6-1.4-1.4.6-1.4 1.4-1.4 1.4.6 1.4 1.4z\"/></svg>\n    </a>\n    <a href=\"#\" aria-label=\"TikTok\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.1z\"/></svg>\n    </a>\n    <a href=\"#\" aria-label=\"X\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg>\n    </a>\n  </div>\n</footer>\n\n<!-- ═══ VIDEO MODAL ═══ -->\n<div class=\"video-modal\" id=\"videoModal\" role=\"dialog\" aria-label=\"OnBase film\">\n  <button class=\"video-modal-close\" id=\"videoModalClose\" aria-label=\"Close video\">✕</button>\n  <div class=\"video-modal-content\">\n    <div class=\"video-modal-placeholder\" id=\"videoPlaceholder\">\n      <h3>Our film is on the way.</h3>\n      <p>We're putting the finishing touches on our launch film — a glimpse into the kind of love OnBase is built for. Check back soon.</p>\n      <p class=\"pl-script\">Coming Summer 2026</p>\n    </div>\n    <!-- When you have a brand film, replace the placeholder above with:\n    <video controls autoplay>\n      <source src=\"https://res.cloudinary.com/didqb05ko/video/upload/onbase_film.mp4\" type=\"video/mp4\">\n    </video>\n    -->\n  </div>\n</div>\n\n<!-- ═══ APP LOGIC ═══ -->\n<script type=\"module\" src=\"app.js\"></script>\n</body>\n</html>\n"
